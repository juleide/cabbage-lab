# Maximum sample rows per exported CSV.
LAB_EXPORT_MAX_ROWS=5000

# R&D access for development. No built-in account; set both values locally and restart.
# Packaged builds use encrypted credentials generated from this file at package time.
# Process environment overrides this file during development. Quote passwords containing # or spaces.
LAB_DEVICE_DEBUG_USERNAME=
LAB_DEVICE_DEBUG_PASSWORD=
